# --- Network ---
HOST=0.0.0.0
PORT=8000
# Database (PostgreSQL)
DATABASE_URL=postgresql://cloudkh:cloudkh_pass@127.0.0.1:5432/cloudkh
# Optional: public controller URL shown in the backend's startup QR code.
# PUBLIC_FRONTEND_URL=https://cloudkh.space

# --- Video stream ---
TARGET_FPS=60
VIDEO_WIDTH=854
VIDEO_HEIGHT=480
VIDEO_BITRATE=4000000
MONITOR_INDEX=1
# On Linux, MONITOR_INDEX numbers connected outputs in `xrandr --query` order
# (1-based). If it can't be resolved, the whole X screen is captured instead.

# --- WebRTC ---
STUN_SERVER=stun://stun.l.google.com:19302

# --- Input ---
# auto = virtual Xbox controller if ViGEmBus available, otherwise keyboard
# keyboard = force keyboard fallback
INPUT_MODE=auto
MOUSE_SENSITIVITY=20

# --- GStreamer (Windows only - leave blank on Linux/macOS) ---
GSTREAMER_BIN=C:\Program Files\gstreamer\1.0\msvc_x86_64\bin
